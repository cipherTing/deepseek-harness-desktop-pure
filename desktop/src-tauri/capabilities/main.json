{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main Harness window can call only application-owned Desktop bridge commands, and only while it is served from the loopback web host.",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:path:deny-resolve",
    "core:path:deny-resolve-directory",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "opener:allow-open-url",
    "allow-desktop-open-external-url",
    "allow-desktop-open-file",
    "allow-desktop-file-handlers",
    "allow-desktop-open-file-with",
    "allow-desktop-copy-text",
    "allow-desktop-reveal-file",
    "allow-desktop-save-file-as",
    "allow-desktop-save-session",
    "allow-desktop-device-info",
    "allow-desktop-log",
    "allow-desktop-credentials-present",
    "allow-desktop-browser-acquire",
    "allow-desktop-browser-bounds",
    "allow-desktop-browser-visible",
    "allow-desktop-browser-navigate",
    "allow-desktop-browser-command",
    "allow-desktop-browser-state",
    "allow-desktop-browser-release",
    "allow-desktop-cli-status",
    "allow-desktop-cli-install",
    "allow-desktop-cli-remove",
    "allow-desktop-keybindings-read",
    "allow-desktop-keybindings-write",
    "allow-desktop-keyboard-configure",
    "allow-desktop-release-state",
    "allow-desktop-release-check"
  ],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  }
}
