{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepDive",
  "version": "../package.json",
  "identifier": "ai.deepseek.harness.desktop",
  "build": {
    "beforeBuildCommand": "pnpm run bundle:prepare",
    "beforeDevCommand": {
      "script": "pnpm run bundle:prepare",
      "wait": true
    },
    "frontendDist": "resources/shell"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "../assets/deepseek.png",
      "../assets/deepseek.icns",
      "../assets/deepseek.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": [
      "rt/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "node-entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/cipherTing/deepseek-harness-desktop-pure/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3Rjg2RkREODBDQjM3QzgKUldUSU44dUEzVy80TjJWVUc4WFJpMlliak02NkhPc0lGWTlzUUIzR1ltcjhwV0hIeDVXaXdVQUcK"
    }
  }
}
