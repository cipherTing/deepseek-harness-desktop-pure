{
  "name": "@deepseek-ai/dsh-desktop",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build:harness": "pnpm -w run build",
    "build:runtime": "node ./scripts/build-runtime.mjs && pnpm run deploy:runtime && node ./scripts/finalize-runtime.mjs",
    "deploy:runtime": "pnpm -C .. --config.inject-workspace-packages=true --config.node-linker=hoisted --config.strict-dep-builds=false --filter @deepseek-ai/dsh-desktop-runtime deploy --prod desktop/src-tauri/rt",
    "prepare:node": "node ./scripts/prepare-node.mjs",
    "bundle:prepare": "node ./scripts/bundle-prepare.mjs",
    "version:check": "node ./scripts/sync-version.mjs --check",
    "version:set": "node ./scripts/sync-version.mjs --set",
    "typecheck": "tsc -p ./tsconfig.json",
    "lint": "oxlint ./bridge/src ./runtime/src",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "test": "node --test ./tests/*.test.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "esbuild": "0.25.10"
  }
}
