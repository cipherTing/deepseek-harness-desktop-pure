{
  "name": "@deepseek-ai/dsh-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:harness": "pnpm -w run build",
    "build:runtime": "node ./scripts/build-runtime.mjs",
    "prepare:assets": "node ./scripts/prepare-assets.mjs",
    "prepare:node": "node ./scripts/prepare-node.mjs",
    "bundle:prepare": "pnpm run build:harness && pnpm run build:runtime && pnpm run prepare:assets && pnpm run prepare:node",
    "version:check": "node ./scripts/sync-version.mjs --check",
    "version:set": "node ./scripts/sync-version.mjs --set",
    "typecheck": "tsc -p ./tsconfig.json",
    "lint": "oxlint ./bridge/src ./runtime/src",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "node ./scripts/build-desktop.mjs",
    "test": "node --test ./tests/*.test.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "esbuild": "0.25.10"
  }
}
