{
  "name": "@deepseek-ai/dsh-desktop-client-ui",
  "version": "0.1.3",
  "private": true,
  "description": "Desktop-only client UI: the About settings section (versions, repository, author, update check) and the update badge beside the settings trigger.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js"
  ]
}
